{
  "model": {
    "num_bands": 31,
    "base_channels": 16,
    "num_half_layer": 5,
    "sample_indices": [1, 3],
    "time_dim": 128,
    "norm_groups": 8,
    "gssa_mode": "hybrid",
    "gssa_content_probability": 0.5
  },
  "diffusion": {
    "timesteps": 1000,
    "sampling_timesteps": 10,
    "beta_schedule": "linear",
    "loss_type": "l2",
    "p2_gamma": 1.0,
    "p2_k": 1.0,
    "ddim_eta": 1.0,
    "clip_min": 0.0,
    "clip_max": 1.0
  },
  "data": {
    "mode": "folder",
    "train_root": "CHANGE_ME",
    "key": null,
    "normalize": "none",
    "patch_size": 64,
    "samples_per_epoch": 10000,
    "augment": true,
    "num_workers": 4,
    "noise": {
      "type": "gaussian",
      "sigma_min": 0.0,
      "sigma_max": 70.0
    }
  },
  "train": {
    "epochs": 100,
    "batch_size": 4,
    "optimizer": "adamw",
    "learning_rate": 0.0001,
    "weight_decay": 0.0,
    "grad_clip": 1.0,
    "amp": true,
    "seed": 2024,
    "output_dir": "runs/hsdt_diff_icvl"
  }
}
